{
  "version": 1,
  "description": "地標名稱與 NAS 圖檔對照。scanSubdirs 涵蓋行程總彙各洲別與主題行程資料夾。",
  "nasRoot": "\\\\192.168.3.3\\【行程總彙】",
  "defaults": {
    "credit": "行程總彙圖庫"
  },
  "scanSubdirs": [
    "0-0-EDM+影片",
    "0-0-領隊投稿專區",
    "0-1主推行程2025",
    "1-1台灣旅遊",
    "1-2.外賓來台",
    "1-3西伯利亞鐵路+俄羅斯",
    "1-4北極光",
    "14.54周年小資行程",
    "2-0 亞洲",
    "3.大洋洲-紐 澳 帛琉 南太",
    "4-1.歐洲",
    "4-2.北美洲",
    "4-3.中美洲",
    "4-4.南美洲",
    "5-非洲",
    "6-1.南北極",
    "6-2.郵輪",
    "7-1.攝影",
    "7-2.婚紗蜜月",
    "7-3.馬拉松",
    "7-4.節慶假日",
    "7-5.身心靈行程",
    "7-6.RV露營車",
    "7-7.高爾夫球",
    "7-8.公益活動",
    "7-9.野外求生活動",
    "India",
    "保留系列資料"
  ],
  "autoMatch": {
    "enabled": true,
    "maxDepth": 5,
    "maxFilesPerSubdir": 2000,
    "minTokenLength": 3,
    "maxCandidatesPerLandmark": 80,
    "matchBasename": true,
    "matchPathContains": true
  },
  "entries": {}
}
